# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/housing_management

# Authentication Security (Replace with a strong random secret in production)
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder

# AI Advisory Configuration (Phase 6 - Gemma and compatible models)
AI_ADVISORY_ENABLED=false
AI_PROVIDER=gemma
GEMMA_API_URL=https://api.example.com/v1/chat/completions
GEMMA_API_KEY=your_gemma_api_key_placeholder
GEMMA_MODEL=gemma-2-9b-it
AI_TIMEOUT_MS=10000

# Notification and Email Configuration (Phase 7)
NOTIFICATION_ENABLED=true
EMAIL_ENABLED=false
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@housing.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
