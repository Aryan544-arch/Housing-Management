<%- include('../partials/header', { title: 'Register Account' }) %>

<div style="max-width: 480px; margin: 3rem auto;">
  <div class="panel">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div class="brand-monogram" style="margin: 0 auto 1rem; width: 44px; height: 44px; font-size: 1.35rem; background: var(--accent-primary); color: var(--text-inverted);">HM</div>
      <div class="eyebrow">MEMBER REGISTRATION</div>
      <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Create Account</h1>
      <p style="font-size: 0.88rem; color: var(--text-secondary);">Enroll as a resident to submit repair manifests, track building maintenance, and receive audit updates.</p>
    </div>

    <!-- Alert Container -->
    <div id="register-alert" class="form-error" role="alert" aria-live="assertive" style="margin-bottom: 1.25rem; padding: 0.75rem 1rem; border-radius: var(--radius-sm); background: var(--accent-crimson-subtle); border: 1px solid rgba(197, 48, 48, 0.3);"></div>

    <form id="register-form" data-redirect="<%= typeof redirectUrl !== 'undefined' ? redirectUrl : '' %>" novalidate>
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="form-group">
        <label for="reg-name" class="form-label">Full Name <span class="required" aria-hidden="true">*</span></label>
        <input 
          type="text" 
          id="reg-name" 
          name="name" 
          class="form-control" 
          placeholder="e.g. Maya Lin" 
          required 
          autocomplete="name"
          aria-describedby="reg-name-error"
          aria-invalid="false"
          autofocus
        >
        <div id="reg-name-error" class="form-error" role="alert">Name must be at least 2 characters long.</div>
      </div>

      <div class="form-group">
        <label for="reg-email" class="form-label">Email Address <span class="required" aria-hidden="true">*</span></label>
        <input 
          type="email" 
          id="reg-email" 
          name="email" 
          class="form-control" 
          placeholder="maya.lin@society.domain" 
          required 
          autocomplete="email"
          aria-describedby="reg-email-error"
          aria-invalid="false"
        >
        <div id="reg-email-error" class="form-error" role="alert">Please provide a valid email address.</div>
      </div>

      <div class="form-group">
        <label for="reg-phone" class="form-label">Phone Number (Optional)</label>
        <input 
          type="tel" 
          id="reg-phone" 
          name="phone" 
          class="form-control" 
          placeholder="+91 98765 43210" 
          autocomplete="tel"
          aria-describedby="reg-phone-help"
        >
        <span id="reg-phone-help" class="form-help">Used for emergency repair verification alerts.</span>
      </div>

      <div class="form-group">
        <label for="reg-password" class="form-label">Password <span class="required" aria-hidden="true">*</span></label>
        <input 
          type="password" 
          id="reg-password" 
          name="password" 
          class="form-control" 
          placeholder="Minimum 8 characters" 
          required 
          autocomplete="new-password"
          aria-describedby="reg-password-error"
          aria-invalid="false"
        >
        <div id="reg-password-error" class="form-error" role="alert">Password must be at least 8 characters long.</div>
      </div>

      <div class="form-group">
        <label for="reg-confirm-password" class="form-label">Confirm Password <span class="required" aria-hidden="true">*</span></label>
        <input 
          type="password" 
          id="reg-confirm-password" 
          name="confirmPassword" 
          class="form-control" 
          placeholder="Re-enter your password" 
          required 
          autocomplete="new-password"
          aria-describedby="reg-confirm-error"
          aria-invalid="false"
        >
        <div id="reg-confirm-error" class="form-error" role="alert">Passwords do not match.</div>
      </div>

      <button type="submit" id="register-submit-btn" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        <span>Create Account & Continue</span>
      </button>
    </form>

    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--border-subtle); text-align: center; font-size: 0.85rem;">
      <span style="color: var(--text-secondary);">Already registered?</span>
      <a href="/login" style="font-weight: 600; margin-left: 0.35rem;">Log In to Portal &rarr;</a>
    </div>
  </div>
</div>

<script src="/js/auth.js"></script>

<%- include('../partials/footer') %>
