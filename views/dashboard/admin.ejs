<%- include('../partials/header', { title: activeSociety ? activeSociety.name + ' | Operations Headquarters' : 'Admin Operations' }) %>

<div style="margin-bottom: 2rem;">
  <!-- Editorial Admin Header -->
  <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border-medium);">
    <div>
      <div class="eyebrow">SOCIETY OPERATIONS HEADQUARTERS</div>
      <h1 style="margin-bottom: 0.25rem;"><%= activeSociety ? activeSociety.name : 'Administrator Console' %></h1>
      <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: var(--text-secondary);">
        <span class="tag-mono"><%= activeSociety ? activeSociety.code : 'CODE' %></span>
        <span>·</span>
        <span class="role-pill admin">FULL ADMINISTRATIVE AUTHORITY</span>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <button type="button" id="refresh-manifest-btn" class="btn btn-secondary btn-sm" title="Refresh live issue manifest from server">
        <span id="refresh-spinner" style="display: none;">⏳</span>
        <span id="refresh-label">↻ Sync API</span>
      </button>
      <a href="/societies/<%= activeSociety._id %>/admin/providers" class="btn btn-secondary btn-sm">
        <span>Contractors & Providers</span>
      </a>
      <a href="/societies/<%= activeSociety._id %>/issues/new" class="btn btn-primary btn-sm">
        <span>+ Log Society Issue</span>
      </a>
    </div>
  </div>

  <input type="hidden" id="society-id-val" value="<%= activeSociety ? activeSociety._id : '' %>">

  <!-- Manifest Sync / Network Error Alert -->
  <div id="manifest-error-alert" class="form-error" role="alert" aria-live="assertive" style="display: none; margin-bottom: 1.25rem; padding: 0.75rem 1rem; border-radius: var(--radius-sm); background: var(--accent-crimson-subtle); border: 1px solid rgba(197, 48, 48, 0.3);"></div>

  <!-- Operational Metrics Grid (Clickable to Filter by Tab) -->
  <div class="metrics-grid">
    <div class="metric-card metric-card-interactive" data-tab-target="needs-review" style="cursor: pointer;" title="Filter by issues needing review">
      <span class="metric-label">Needs Admin Review</span>
      <span class="metric-value" id="metric-admin-review" style="color: var(--accent-blueprint);"><%= issues ? issues.filter(i => ['submitted', 'under_review'].includes(i.status)).length : 0 %></span>
      <span class="metric-sub">Newly submitted or under review</span>
    </div>

    <div class="metric-card metric-card-interactive" data-tab-target="awaiting-verification" style="cursor: pointer;" title="Filter by issues awaiting verification">
      <span class="metric-label">Awaiting Verification</span>
      <span class="metric-value" id="metric-admin-verification" style="color: var(--accent-amber);"><%= issues ? issues.filter(i => i.status === 'completion_submitted').length : 0 %></span>
      <span class="metric-sub">Completion submitted; pending sign-off</span>
    </div>

    <div class="metric-card metric-card-interactive" data-tab-target="in-repair" style="cursor: pointer;" title="Filter by issues in active repair">
      <span class="metric-label">Active Repairs</span>
      <span class="metric-value" id="metric-admin-repairs"><%= issues ? issues.filter(i => ['scheduled', 'in_progress', 'provider_contact_pending', 'awaiting_information', 'verification_rejected', 'reopened'].includes(i.status)).length : 0 %></span>
      <span class="metric-sub">Scheduled or in physical repair</span>
    </div>

    <div class="metric-card metric-card-interactive" data-tab-target="closed" style="cursor: pointer;" title="Filter by verified closed issues">
      <span class="metric-label">Verified & Closed</span>
      <span class="metric-value" id="metric-admin-closed" style="color: var(--accent-sage);"><%= issues ? issues.filter(i => ['verified_closed', 'cancelled'].includes(i.status)).length : 0 %></span>
      <span class="metric-sub">Closed with verified audit trail</span>
    </div>
  </div>

  <!-- Admin Issue Queue Panel -->
  <div class="panel">
    <div class="panel-header" style="flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <h2 class="panel-title">OPERATIONS QUEUE & TRIAGE</h2>
        <span class="tag-mono" id="issue-count-tag"><%= issues ? issues.length : 0 %> ISSUES IN SCOPE</span>
      </div>

      <!-- Advanced Filter Controls -->
      <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
        <select id="filter-status" class="form-control" style="width: auto; padding: 0.4rem 0.65rem; font-size: 0.82rem;" aria-label="Filter issues by status">
          <option value="">All Statuses (<%= issues ? issues.length : 0 %>)</option>
          <option value="submitted">Submitted</option>
          <option value="under_review">Under Review</option>
          <option value="awaiting_information">Awaiting Info</option>
          <option value="provider_contact_pending">Provider Pending</option>
          <option value="scheduled">Scheduled</option>
          <option value="in_progress">In Progress</option>
          <option value="completion_submitted">Completion Submitted</option>
          <option value="verification_rejected">Verification Rejected</option>
          <option value="verified_closed">Verified & Closed</option>
          <option value="reopened">Reopened</option>
          <option value="cancelled">Cancelled</option>
        </select>

        <select id="filter-priority" class="form-control" style="width: auto; padding: 0.4rem 0.65rem; font-size: 0.82rem;" aria-label="Filter issues by priority">
          <option value="">All Priorities</option>
          <option value="urgent">Urgent</option>
          <option value="high">High</option>
          <option value="normal">Normal</option>
          <option value="low">Low</option>
        </select>

        <select id="filter-category" class="form-control" style="width: auto; padding: 0.4rem 0.65rem; font-size: 0.82rem;" aria-label="Filter issues by category">
          <option value="">All Categories</option>
          <option value="plumbing">Plumbing</option>
          <option value="electrical">Electrical</option>
          <option value="carpentry">Carpentry</option>
          <option value="security">Security</option>
          <option value="housekeeping">Housekeeping</option>
          <option value="elevator">Elevator</option>
          <option value="common_area">Common Area</option>
          <option value="structural">Structural</option>
          <option value="other">Other</option>
        </select>

        <select id="sort-issues" class="form-control" style="width: auto; padding: 0.4rem 0.65rem; font-size: 0.82rem;" aria-label="Sort issues">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="priority">Highest Priority</option>
        </select>

        <input 
          type="text" 
          id="search-issues" 
          class="form-control" 
          placeholder="Search title, resident, unit..." 
          style="width: 190px; padding: 0.4rem 0.65rem; font-size: 0.82rem;"
          aria-label="Search issue manifest"
        >

        <button type="button" id="clear-filters-btn" class="btn btn-outline btn-sm" title="Clear all active filters">
          Reset
        </button>
      </div>
    </div>

    <!-- Operational Workflow Tabs -->
    <div class="tab-group" style="margin-top: 1rem;">
      <button type="button" class="tab-btn active" data-tab="all">All Operations (<%= issues ? issues.length : 0 %>)</button>
      <button type="button" class="tab-btn" data-tab="needs-review">Needs Triage (<%= issues ? issues.filter(i => ['submitted', 'under_review'].includes(i.status)).length : 0 %>)</button>
      <button type="button" class="tab-btn" data-tab="in-repair">Active Repairs (<%= issues ? issues.filter(i => ['scheduled', 'in_progress', 'provider_contact_pending', 'awaiting_information', 'verification_rejected', 'reopened'].includes(i.status)).length : 0 %>)</button>
      <button type="button" class="tab-btn" data-tab="awaiting-verification">Pending Sign-off (<%= issues ? issues.filter(i => i.status === 'completion_submitted').length : 0 %>)</button>
      <button type="button" class="tab-btn" data-tab="closed">Verified Closed (<%= issues ? issues.filter(i => ['verified_closed', 'cancelled'].includes(i.status)).length : 0 %>)</button>
    </div>

    <!-- Issues Table Container -->
    <div id="issues-container" style="margin-top: 0.5rem;">
      <% if (!issues || issues.length === 0) { %>
        <div style="text-align: center; padding: 3.5rem 1.5rem; color: var(--text-muted);">
          <div style="font-size: 2.5rem; margin-bottom: 0.75rem; opacity: 0.6;">📋</div>
          <h3 style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 0.35rem;">No Society Issues Recorded</h3>
          <p style="font-size: 0.88rem; max-width: 440px; margin: 0 auto 1.25rem;">There are currently no maintenance or operations manifests registered for this society.</p>
          <a href="/societies/<%= activeSociety._id %>/issues/new" class="btn btn-primary btn-sm">+ Log First Society Issue</a>
        </div>
      <% } else { %>
        <div class="table-container">
          <table class="data-table" id="admin-issues-table">
            <thead>
              <tr>
                <th>REF / ID</th>
                <th>Summary & Submitter</th>
                <th>Category</th>
                <th>Location</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Logged</th>
                <th style="text-align: right;">Review Action</th>
              </tr>
            </thead>
            <tbody>
              <% issues.forEach(function(issue) { %>
                <tr 
                  class="issue-row" 
                  data-id="<%= issue._id %>"
                  data-status="<%= issue.status %>" 
                  data-priority="<%= issue.priority %>" 
                  data-priority-rank="<%= issue.priority === 'urgent' ? 4 : (issue.priority === 'high' ? 3 : (issue.priority === 'normal' ? 2 : 1)) %>"
                  data-category="<%= issue.category %>"
                  data-location-type="<%= issue.location ? issue.location.type : '' %>"
                  data-title="<%= (issue.title || '').toLowerCase() %>"
                  data-resident="<%= (issue.submittingResident && issue.submittingResident.name) ? issue.submittingResident.name.toLowerCase() : '' %>"
                  data-unit="<%= (issue.location && issue.location.type === 'unit') ? (issue.location.blockOrWing + ' ' + issue.location.flatOrUnit).toLowerCase() : '' %>"
                  data-created="<%= new Date(issue.createdAt).getTime() %>"
                >
                  <td>
                    <span class="tag-mono">#<%= issue._id.toString().slice(-6).toUpperCase() %></span>
                  </td>
                  <td>
                    <a href="/societies/<%= activeSociety._id %>/issues/<%= issue._id %>" style="font-weight: 600; color: var(--text-primary); display: block;">
                      <%= issue.title %>
                    </a>
                    <span style="font-size: 0.78rem; color: var(--text-muted);">
                      By: <%= (issue.submittingResident && issue.submittingResident.name) ? issue.submittingResident.name : 'Unknown' %>
                      <%= (issue.submittingResident && issue.submittingResident.phone) ? ' · ' + issue.submittingResident.phone : '' %>
                    </span>
                    <% if (issue.cancellationReason) { %>
                      <div style="font-size: 0.75rem; color: var(--accent-crimson);">Cancelled: <%= issue.cancellationReason %></div>
                    <% } %>
                  </td>
                  <td>
                    <span class="tag-mono" style="text-transform: capitalize;"><%= issue.category %></span>
                  </td>
                  <td>
                    <% if (issue.location && issue.location.type === 'unit') { %>
                      <span style="font-size: 0.82rem; font-weight: 500;">
                        Unit: <%= issue.location.blockOrWing %> - <%= issue.location.flatOrUnit %>
                      </span>
                    <% } else if (issue.location && issue.location.type === 'common_area') { %>
                      <span style="font-size: 0.82rem; color: var(--accent-blueprint);">
                        Common: <%= issue.location.areaDescription %>
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge-priority <%= issue.priority %>"><%= issue.priority %></span>
                  </td>
                  <td>
                    <span class="badge-status <%= issue.status %>"><%= issue.status.replace(/_/g, ' ') %></span>
                  </td>
                  <td style="font-family: var(--font-mono); font-size: 0.78rem;">
                    <%= new Date(issue.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </td>
                  <td style="text-align: right;">
                    <% if (issue.status === 'submitted') { %>
                      <a href="/societies/<%= activeSociety._id %>/issues/<%= issue._id %>" class="btn btn-primary btn-sm">
                        Review & Triage &rarr;
                      </a>
                    <% } else if (issue.status === 'completion_submitted') { %>
                      <a href="/societies/<%= activeSociety._id %>/issues/<%= issue._id %>" class="btn btn-secondary btn-sm" style="color: var(--accent-amber); font-weight: 700;">
                        Verify & Sign-off &rarr;
                      </a>
                    <% } else if (issue.status === 'awaiting_information') { %>
                      <a href="/societies/<%= activeSociety._id %>/issues/<%= issue._id %>" class="btn btn-outline btn-sm">
                        Awaiting Info &rarr;
                      </a>
                    <% } else if (['scheduled', 'in_progress'].includes(issue.status)) { %>
                      <a href="/societies/<%= activeSociety._id %>/issues/<%= issue._id %>" class="btn btn-outline btn-sm">
                        Track Repair &rarr;
                      </a>
                    <% } else { %>
                      <a href="/societies/<%= activeSociety._id %>/issues/<%= issue._id %>" class="btn btn-outline btn-sm">
                        Manage &rarr;
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>

              <!-- Filtered Empty State Row -->
              <tr id="no-matching-issues-row" style="display: none;">
                <td colspan="8" style="text-align: center; padding: 2.5rem 1.5rem; color: var(--text-muted);">
                  <div style="font-family: var(--font-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-amber); margin-bottom: 0.35rem;">
                    [ NO MATCHING RECORDS ]
                  </div>
                  <div style="font-size: 0.92rem; color: var(--text-primary); margin-bottom: 0.75rem;">
                    No maintenance issues match your current filter selection.
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm clear-filters-trigger">
                    Clear All Filters
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
          <div id="manifest-loading-indicator" style="display: none; padding: 2rem; text-align: center; color: var(--text-muted); background: var(--bg-surface-elevated); border-top: 1px solid var(--border-subtle);">
            <div style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent-amber);">
              [ SYNCING SOCIETY OPERATIONS QUEUE... ]
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/issues.js"></script>

<%- include('../partials/footer') %>
