<%- include('../partials/header', { title: title || 'Issue Error' }) %>

<div style="max-width: 640px; margin: 3rem auto; text-align: center;">
  <div class="panel" style="padding: 3rem 2rem;">
    <div class="tag-mono" style="display: inline-block; color: <%= errorCode === 404 ? 'var(--accent-terracotta)' : 'var(--accent-crimson)' %>; margin-bottom: 0.75rem;">
      <%= errorCode || 404 %> · <%= errorTitle ? errorTitle.toUpperCase() : 'NOTICE' %>
    </div>
    
    <h1 style="font-size: 1.75rem; margin-bottom: 0.75rem; font-family: var(--font-heading);">
      <%= errorTitle || 'Issue Manifest Unavailable' %>
    </h1>

    <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 480px; margin: 0 auto 1.75rem;">
      <%= errorMessage || 'The requested issue could not be accessed or located in this society.' %>
    </p>

    <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
      <a href="<%= returnUrl || '/dashboard' %>" class="btn btn-primary">
        <span>&larr; <%= returnLabel || 'Return to Dashboard' %></span>
      </a>
      <a href="/dashboard" class="btn btn-outline">
        <span>Operational Overview</span>
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
